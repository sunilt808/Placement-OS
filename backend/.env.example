# ============================================================
# PlacementOS — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── Admin login (dashboard) — CHOOSE STRONG VALUES ──────────
ADMIN_USERNAME=your_username
ADMIN_PASSWORD=change_me_strong_password
ADMIN_SECURITY_CODE=00000
JWT_SECRET=generate_with: openssl rand -hex 32

# ── CORS (dashboard origins allowed to call the API) ────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── API docs (Swagger UI at /docs) — keep false in production
DOCS_ENABLED=false

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=placement_monitor

# ── Telethon userbot (my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=        # generated by setup_session.py
PLACEMENT_GROUP_ID=             # numeric id of the placement group

# ── Notification bot (@BotFather) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=               # your personal Telegram user id

# ── Student identity (Excel shortlist matching) ─────────────
STUDENT_NAME=Sunil T
STUDENT_USN=1DS24CS421

# ── Gemini (OPTIONAL — system runs fully offline without it) ─
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=
GEMINI_PRO_MODEL=

# ── Auto-notifications ───────────────────────────────────────
STARTUP_PING=true
AUTO_NOTIFY_NEW_OPPORTUNITY=true

# ── Tuning (defaults are fine) ───────────────────────────────
TIMEZONE=
CATCHUP_DAYS=10
WATCHDOG_INTERVAL_MINUTES=30
DAILY_SUMMARY_HOUR=8
MESSAGE_RETENTION_DAYS=3
EXPIRY_GRACE_HOURS=12
DATA_RETENTION_DAYS=
STORAGE_LIMIT_MB=
STORAGE_WARN_MB=
